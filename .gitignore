.env
*.env.local

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Model weights — fetched on first run, never committed. The directory itself is
# tracked: compose bind-mounts it, and a path Docker has to create first is
# created root-owned, which the container (running as you) then cannot write.
models/*
!models/.gitkeep

# Evidence and artifacts are deliverables, so they are NOT ignored wholesale.
# Only scratch runs are.
evidence/scratch/
evidence/**/*.tmp
.gstack/
