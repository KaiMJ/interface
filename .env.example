# Copy to .env — never commit the real thing.
#
#   cp .env.example .env

# --- Model ------------------------------------------------------------------
# Routed through LiteLLM, so this is a provider-qualified model string and the
# credential is whichever env var that provider expects. Swapping providers is a
# one-line change here; nothing in the agent loop knows which one is in use.
#
# The model MUST support vision and tool calling — the loop's entire input is a
# screenshot and its entire output is one structured action.
#
#   xai/grok-4                     XAI_API_KEY
#   anthropic/claude-opus-5        ANTHROPIC_API_KEY
#   openai/gpt-5                   OPENAI_API_KEY
#   openai/<name> + CUA_API_BASE   any OpenAI-compatible endpoint (vLLM, Ollama)
#
CUA_MODEL=xai/grok-4

# Set only the one your CUA_MODEL needs. All are passed through to the container.
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: point at a proxy or a self-hosted OpenAI-compatible endpoint.
# CUA_API_BASE=http://localhost:4000

# Required for DISCOVERY runs only. Replay never calls a model, so a reviewer can
# exercise the deterministic path with every key above left blank.

# --- Surface ----------------------------------------------------------------
# Virtual display geometry. Recorded into every artifact: coordinates are
# normalized 0-1, but the recording viewport is part of the contract.
CUA_DISPLAY_WIDTH=1440
CUA_DISPLAY_HEIGHT=900

# --- Target app credentials -------------------------------------------------
# The demo bank's teller login. Resolved at execution time in the action layer and
# never written into an artifact, a log, or a model prompt.
CUA_TARGET_USERNAME=teller01
CUA_TARGET_PASSWORD=demo-password-not-a-real-one
