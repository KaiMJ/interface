# Copy to .env — never commit the real thing.

# --- Model ------------------------------------------------------------------
# Routed through LiteLLM, so this is a provider-qualified string and the credential is
# whichever env var that provider expects. The model must support vision and tool
# calling. Discovery only: replay never constructs a model client.
#
#   xai/grok-4                     XAI_API_KEY
#   anthropic/claude-opus-5        ANTHROPIC_API_KEY
#   openai/gpt-5                   OPENAI_API_KEY
#   openai/<name> + CUA_API_BASE   any OpenAI-compatible endpoint
#
CUA_MODEL=xai/grok-4

XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# CUA_API_BASE=http://localhost:4000

# --- Surface ----------------------------------------------------------------
# Recorded into every artifact: coordinates are normalized 0-1, but the recording
# viewport is part of the contract.
CUA_DISPLAY_WIDTH=1440
CUA_DISPLAY_HEIGHT=900

# Text recognition backend. `torch` reaches the GPU; without one, use `onnxruntime`
# and drop the `deploy:` block from docker-compose.yml.
CUA_OCR_ENGINE=torch

# --- Application ------------------------------------------------------------
# Guardrails live in policies/<app>.yaml and every command takes `--app <name>`.
# This is the fallback for `cua discover`, which runs before an artifact exists.
CUA_DEFAULT_APP=targetapp

# Where this deployment's install of that app lives. Overrides the policy default,
# which is how a second institution on the same vendor product is configured.
# CUA_TARGET_BASE_URL=http://targetapp:8080

# --- Target app credentials -------------------------------------------------
# Resolved at execution time in the action layer; never written into an artifact,
# a log, or a model prompt.
CUA_TARGET_USERNAME=teller01
CUA_TARGET_PASSWORD=demo-password-not-a-real-one
